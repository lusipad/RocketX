{
  "name": "rocketchatx",
  "private": true,
  "version": "0.43.6",
  "packageManager": "pnpm@11.12.0",
  "scripts": {
    "dev": "pnpm --filter @rcx/web dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "bridge": "pnpm --filter @rcx/ado-bridge dev",
    "smoke": "tsx scripts/smoke.ts",
    "spike:rc-offline-contract": "tsx scripts/spike-rc-offline-contract.ts",
    "test:pure": "tsx scripts/test-pure.ts",
    "test:regression": "pnpm --filter @lusipad/rocketx build && tsx --test scripts/regressions/*.test.ts",
    "test:ui": "playwright test",
    "test:ui:release": "playwright test --config playwright.release.config.ts --grep @release-desktop",
    "test:ecosystem": "node scripts/test-app-ecosystem.mjs",
    "codex:protocol:generate": "node scripts/codex-protocol.mjs --write",
    "codex:protocol:check": "node scripts/codex-protocol.mjs --check",
    "smoke:codex-app-server": "tsx scripts/smoke-codex-app-server.mjs --runtime pinned",
    "smoke:codex-app-server:system": "tsx scripts/smoke-codex-app-server.mjs --runtime system",
    "smoke:codex-lifecycle": "tsx scripts/smoke-codex-lifecycle.ts --runtime pinned",
    "smoke:codex-lifecycle:system": "tsx scripts/smoke-codex-lifecycle.ts --runtime system",
    "spike:codex-shell-contract": "tsx scripts/spike-codex-shell-contract.ts",
    "spike:codex-mcp-config": "tsx scripts/spike-codex-mcp-config.ts",
    "spike:business-mcp-runtime": "tsx scripts/spike-business-mcp-runtime.ts",
    "spike:codex-plugin-marketplace": "tsx scripts/spike-codex-plugin-marketplace.ts",
    "measure:memory": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/measure-desktop-memory.ps1",
    "measure:memory:trend": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/measure-desktop-memory.ps1 -Samples 31 -IntervalSeconds 60 -MaxPrivateMB 350 -MaxGrowthMB 50 -CsvPath memory-trend.csv",
    "gen:emoji": "tsx scripts/gen-emoji.ts",
    "test:classify": "tsx scripts/test-classify.ts",
    "package:plugins": "node scripts/package-plugins.mjs",
    "prepare:codex": "node scripts/prepare-codex-resource.mjs",
    "prepare:sidecars": "node scripts/prepare-plugin-sidecars.mjs",
    "prepare:dsh-runtime": "node scripts/prepare-dsh-runtime.mjs"
  },
  "devDependencies": {
    "@openai/codex": "0.144.4",
    "@playwright/test": "1.61.1",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "emoji-toolkit": "^10.0.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tsx": "^4.19.0"
  }
}
