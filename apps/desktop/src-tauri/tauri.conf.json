{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "RocketX",
  "version": "0.43.23",
  "identifier": "com.lusipad.rocketx",
  "build": {
    "beforeDevCommand": "pnpm -w prepare:sidecars && pnpm --filter @rcx/web dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "pnpm -w prepare:sidecars && pnpm --filter @rcx/web build",
    "frontendDist": "../../web/dist"
  },
  "app": {
    "windows": [
      {
        "title": "RocketX",
        "width": 1280,
        "height": 800,
        "minWidth": 940,
        "minHeight": 640,
        "center": true,
        "visible": false,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' asset: blob: ipc: http://ipc.localhost http: https: ws: wss:; img-src 'self' asset: http: https: data: blob:; media-src 'self' asset: http: https: blob:; font-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline'; worker-src 'self' blob:; frame-src 'self' data: blob: http://127.0.0.1:*; object-src 'none'; base-uri 'self'; form-action 'self'",
      "dangerousDisableAssetCspModification": ["script-src"]
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": "all",
    "resources": {
      "resources/codex-skills/": "codex-skills/",
      "../../web/src/butler/skills/core/": "rocketx-core-skills/",
      "resources/plugins/": "plugins/",
      "src/dsh_bridge.mjs": "dsh_bridge.mjs"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "installerHooks": "./windows/slim-installer-hooks.nsh"
      }
    },
    "macOS": {
      "signingIdentity": "-"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDE5MzhFNzU5Q0ZDRDQ3MTIKUldRU1I4M1BXZWM0R1owekdDWWwyV3ZwTlFuRnNwNlZOK0QwMVRUNUNFSmhSdkJBYzZsMDBaSjYK",
      "dangerousInsecureTransportProtocol": true,
      "endpoints": [
        "https://github.com/lusipad/RocketX/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
